{
  "name": "minhaagenda",
  "private": true,
  "description": "Agendamento online para beleza e bem-estar",
  "scripts": {
    "build": "npm run build:icons && npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.js -i estilo-fonte.css -o app.css --minify",
    "build:icons": "node gerar-icones.mjs",
    "dev": "tailwindcss -c tailwind.config.js -i estilo-fonte.css -o app.css --watch"
  },
  "devDependencies": {
    "lucide": "0.460.0",
    "tailwindcss": "3.4.17"
  }
}
