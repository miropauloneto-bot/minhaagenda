# =====================================================================
# Servidor web da MinhaAgenda (Caddy): HTTPS automático + cabeçalhos de segurança.
# O domínio vem do arquivo .env (DOMINIO=seudominio.com.br).
# =====================================================================
{$DOMINIO} {
	encode zstd gzip
	root * /srv

	# Arquivos internos do projeto nunca são servidos
	@interno path /node_modules/* /.git/* /.env /env.exemplo /schema.sql /package.json /package-lock.json /tailwind.config.js /README.md /.gitignore /.nojekyll /verificar.html /estilo-fonte.css /gerar-icones.mjs /Caddyfile /docker-compose.yml /atualizar.sh
	respond @interno 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}

	# Endereços bonitos e links antigos: /painel/ e /agendar/?n=... continuam funcionando
	redir /painel /painel.html 301
	redir /painel/ /painel.html 301
	redir /agendar /agendar.html?{query} 301
	redir /agendar/ /agendar.html?{query} 301
	redir /privacidade/ /privacidade.html 301

	# Fontes: cache longo. Páginas, CSS e JS: sempre conferem se há versão nova.
	@fontes path *.woff2
	header @fontes Cache-Control "public, max-age=31536000, immutable"
	@resto not path *.woff2
	header @resto Cache-Control "no-cache"

	# O painel nunca aparece no Google
	@painel path /painel.html
	header @painel X-Robots-Tag "noindex, nofollow"

	handle_errors {
		@404 expression {err.status_code} == 404
		redir @404 / 302
	}

	file_server
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
